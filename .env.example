# Adapted from Zotero Plugin Template .env.example; AGPL-3.0-or-later.
# Use BOTH a separate development profile and separate empty test data directory.
# Do not start serve with a production Zotero process/profile. No account token needed.
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_PROFILE_PATH=/absolute/path/to/rainbowbionic-test-profile
ZOTERO_PLUGIN_DATA_DIR=/absolute/path/to/rainbowbionic-empty-test-data
